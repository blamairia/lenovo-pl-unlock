#!/bin/sh
# lpl-set-profile <profile_name>
# Switches Lenovo PL unlock profile via setPL.sh
case "$1" in
  idle)        PL1=8;  PL2=8 ;;
  daily)       PL1=36; PL2=58 ;;
  performance) PL1=45; PL2=65 ;;
  burst)       PL1=60; PL2=90 ;;
  current)
    awk '{printf "%.0f\n", $1/1e6}' /sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw
    exit 0
    ;;
  *) echo "Usage: $0 {idle|daily|performance|burst|current}" >&2; exit 1 ;;
esac
/sbin/modprobe msr 2>/dev/null
/usr/local/bin/setPL.sh "$PL1" "$PL2" > /dev/null 2>&1
echo 1000000 > /sys/class/powercap/intel-rapl:0/constraint_0_time_window_us
echo "$1 ($PL1W / $PL2W)"
