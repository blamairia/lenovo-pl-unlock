[Unit]
Description=Apply CPU performance tweaks at boot
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Enable HWP dynamic boost (faster freq ramp under load)
ExecStart=/bin/sh -c 'echo 1 > /sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost'
# Force EPP=performance on every core
ExecStart=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo performance > "$f"; done'
# Make RAPL energy counters readable so the tray can show wattage
ExecStart=/bin/sh -c 'chmod a+r /sys/class/powercap/intel-rapl:0/energy_uj /sys/class/powercap/intel-rapl:0:0/energy_uj /sys/class/powercap/intel-rapl:0:1/energy_uj 2>/dev/null || true'
# Set GNOME power profile to performance (best-effort, may fail at boot before user session)
ExecStart=-/bin/sh -c 'sleep 5; sudo -u billell DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus /usr/bin/powerprofilesctl set performance 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
